# ---- Database ----
DATABASE_URL=postgresql+asyncpg://nexus:nexus_pass@localhost:5432/nexus_lore

# ---- AI Provider ----
# ollama | openai | deepseek
AI_PROVIDER=ollama
AI_API_KEY=
AI_ENDPOINT=http://localhost:11434
AI_MODEL=llama3
# Docker 访问宿主机 Ollama 时使用；云端 provider 可改成对应 API 地址。
DOCKER_AI_ENDPOINT=http://host.docker.internal:11434

# ---- App ----
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
